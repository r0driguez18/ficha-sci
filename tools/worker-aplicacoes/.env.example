# Copia este ficheiro para ".env" (ao lado do worker.py) e preenche. O ".env" NUNCA vai para o git.

# Endereço da API da app (o mesmo que a app usa), sem barra no fim.
# Produção: o endereço do servidor (nginx). Local: http://localhost:8000
SUPABASE_URL=
# A chave "anon" da app (a mesma VITE_SUPABASE_PUBLISHABLE_KEY do .env da app). Não é secreta.
SUPABASE_ANON_KEY=
# O token deste worker (um administrador cria-o na base: select criar_token_worker('PC do cabo'); aparece uma só vez).
WORKER_TOKEN=

# Core bancário (iSeries)
CORE_SISTEMA=
CORE_UTILIZADOR=
CORE_SENHA=

# Opcionais
# CORE_QUERY=SELECT * from GBANCA0003.GBAPL   (por omissão o worker pede as linhas dos 2 dias da ficha: ACDTIN = D e D+1; se definires isto, corre-se tal e qual)
# POLL_SEGUNDOS=3
# Se o servidor usa um certificado interno: caminho para o .pem da empresa
# CA_BUNDLE=C:\certificados\empresa.pem
# Certificado autoassinado só com CN=IP (sem "subjectAltName"): o Python recusa-o por nome. Em vez de CA_BUNDLE, fixa-se a
# impressão digital (SHA-256) do certificado do servidor. Como calculá-la: ver o README.
# SERVER_CERT_SHA256=
